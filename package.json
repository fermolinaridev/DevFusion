{
  "name": "devfusion",
  "productName": "DevFusion",
  "version": "0.3.0-beta.1",
  "private": true,
  "description": "Workspace desktop local para usar Claude Code e Codex lado a lado pelas CLIs oficiais.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "test:coverage": "vitest run --coverage",
    "test:real": "node scripts/run-real-tests.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --dir",
    "icon": "electron scripts/render-icon.cjs",
    "test:package": "playwright test -c playwright.package.config.ts"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "zustand": "5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.18"
  },
  "author": "DevFusion"
}
